# SonarQube Analysis Environment Variables

# Google API Key for Drive access (required)
GOOGLE_API_KEY=your_google_api_key_here

# SonarQube Configuration
SONAR_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_token_here
SONAR_PROJECT_KEY=arthas-analysis

# Optional: Override default repository and date
# DEFAULT_REPO=https://github.com/alibaba/arthas.git
# DEFAULT_DATE=2022-01-01
# DEFAULT_BRANCH=master