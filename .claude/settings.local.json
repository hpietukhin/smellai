{
  "permissions": {
    "allow": [
      "WebFetch(domain:context7.com)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__ide__executeCode",
      "WebFetch(domain:weave-docs.wandb.ai)",
      "WebSearch",
      "WebFetch(domain:tilburgsciencehub.com)",
      "Bash(chmod:*)",
      "Bash(pip install:*)",
      "Bash(python -m pytest sonarqube_api/test_api.py -v)",
