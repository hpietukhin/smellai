# =============================================================================
# LLM-Based Code Smell Detection - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------

# Cerebras API Key for LLM inference
# Get yours at: https://inference.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Google API Key for embeddings (text-embedding-004)
# Get yours at: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# MySQL Database Configuration (DACOS Database)
# -----------------------------------------------------------------------------

# MySQL server hostname or IP address
MYSQL_HOST=localhost

# MySQL server port (default: 3306)
MYSQL_PORT=3306

# Database name containing DACOS samples
MYSQL_DATABASE=dacos

# MySQL username (read-only recommended)
MYSQL_USER=dacos_reader

# MySQL password
MYSQL_PASSWORD=your_mysql_password_here

# -----------------------------------------------------------------------------
# SonarQube Configuration
# -----------------------------------------------------------------------------

# SonarQube server URL (default for local Docker instance)
SONAR_URL=http://localhost:9000

# SonarQube authentication token
# Generate at: SonarQube UI > User > My Account > Security > Generate Token
SONAR_TOKEN=your_sonarqube_token_here

# -----------------------------------------------------------------------------
# MLflow Tracking and Tracing Configuration
# -----------------------------------------------------------------------------

# MLflow tracking server URI (default: local ./mlruns directory)
# For remote server: http://your-mlflow-server:5000
MLFLOW_TRACKING_URI=./mlruns

# MLflow experiment name for organizing evaluation runs
MLFLOW_EXPERIMENT_NAME=code-smell-evaluation

# -----------------------------------------------------------------------------
# Optional: Advanced Configuration
# -----------------------------------------------------------------------------

# LLM Model Configuration
# LLM_MODEL=cerebras/llama3.1-8b
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096

# Embedding Model
# EMBEDDING_MODEL=models/text-embedding-004

# Git Configuration
# COMMIT_CUTOFF_DATE=2023-01-24

# Paths
# TEMP_CLONE_DIR=./temp/clones
# VECTOR_DB_PATH=./data/deeplake/smells
# EVAL_RESULTS_DIR=./eval_results

# Limits
# MAX_FILE_SIZE_KB=500
# MAX_SAMPLES_PER_BATCH=100
