# LLM Provider API Keys (at least one required)
# Get OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Cerebras for fast inference (alternative to OpenAI)
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Anthropic Claude models (optional alternative provider)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# SonarQube Configuration (required for code smell detection - Agent A1)
# Create token in SonarQube UI: My Account → Security → Generate Tokens
SONAR_URL=http://localhost:9000
SONAR_TOKEN=your-sonarqube-token-here

# MLflow Experiment Tracking (optional, uses default if not set)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
